{
  "rewrites": [
    { "source": "/product/:id(\\d+)", "destination": "/api/meta?type=product&id=:id" },
    { "source": "/category/:cat", "destination": "/api/meta?type=category&cat=:cat" },
    { "source": "/category/:cat/:sub", "destination": "/api/meta?type=category&cat=:cat&sub=:sub" },
    {
      "source": "/((?!api/|sitemap[^/]*\\.xml|facebook-catalog\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}