{
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "autoshop-market.vercel.app"
        }
      ],
      "destination": "https://autoshopmarket.com.ua/:path",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-:page(\\d+).xml",
      "destination": "/api/sitemap?page=:page"
    },
    {
      "source": "/admin/stats",
      "destination": "/api/stats"
    },
    {
      "source": "/search",
      "destination": "/api/meta?type=search"
    },
    {
      "source": "/product/:id(\\d+)",
      "destination": "/api/meta?type=product&id=:id"
    },
    {
      "source": "/category/:cat",
      "destination": "/api/meta?type=category&cat=:cat"
    },
    {
      "source": "/category/:cat/:sub",
      "destination": "/api/meta?type=category&cat=:cat&sub=:sub"
    },
    {
      "source": "/catalog/:mark",
      "destination": "/api/meta?type=catalog&mark=:mark"
    },
    {
      "source": "/catalog/:mark/:model",
      "destination": "/api/meta?type=catalog&mark=:mark&model=:model"
    },
    {
      "source": "/catalog/:mark/:model/:cat",
      "destination": "/api/meta?type=catalog&mark=:mark&model=:model&cat=:cat"
    },
    {
      "source": "/catalog/:mark/:model/:cat/:sub",
      "destination": "/api/meta?type=catalog&mark=:mark&model=:model&cat=:cat&sub=:sub"
    },
    {
      "source": "/((?!api/|facebook-catalog\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
